# cp wrangler.toml.example wrangler.toml して、値を自分の環境に合わせる。
# wrangler.toml は database_id が入るので .gitignore 済み。

name = "toggl-slack-tasks"
main = "src/index.ts"
compatibility_date = "2026-08-01"

# D1 を作る:  npx wrangler d1 create moodle_bot
# 出力された database_id を下に貼る
[[d1_databases]]
binding = "DB"
database_name = "moodle_bot"
database_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
migrations_dir = "migrations"

[vars]
# 大学の Moodle のベース URL（末尾スラッシュなし）
MOODLE_BASE_URL = "https://moodle.example.ac.jp"
# "ws" = Web Services / "ical" = カレンダーエクスポート
MOODLE_MODE = "ws"
# 表示・通知時刻の判定に使うタイムゾーン（UTC からのオフセット分）。540 = JST
TIMEZONE_OFFSET_MIN = "540"
# 通知先チャンネル。空なら SLACK_USER_ID への DM
SLACK_TARGET_CHANNEL = ""

# Cron Triggers は無料枠 3 本まで。ダイジェストと週次サマリは
# 同期に相乗りしてローカル時刻で判定するので、cron に時刻は埋めない。
[triggers]
crons = [
  "*/15 * * * *",  # 同期 + リマインド + ダイジェスト + 週次サマリ
  "*/5 * * * *"    # Toggl の計測中 entry を App Home に反映
]

[observability]
enabled = true
